# =============================================================================
# Agrimitra Frontend - Environment Variables (Vite)
# Copy this file to `.env` and fill in the values.
# Only the ANON (public) Supabase key goes here - never the service role key.
# =============================================================================

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase ANON (public) key - safe to expose in the browser.
# Dashboard -> Project Settings -> API -> Project API keys -> anon public
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: override the backend API base URL used by the Vite dev proxy
# VITE_API_TARGET=http://localhost:5000
