# =============================================================================
# Agrimitra - Environment Variables
# Copy this file to `.env` and fill in your own keys.
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit `.env` to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
# Which AI backend the KRISHI SAKHI chat uses: `gemini` or `openai`.
# If left empty, the server auto-detects: Gemini key -> gemini, else OpenAI.
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (https://platform.openai.com/api-keys)
# Only required when AI_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Weather (current conditions + 24h rain probability)
# -----------------------------------------------------------------------------
# OpenWeather (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# -----------------------------------------------------------------------------
# Translation (optional)
# -----------------------------------------------------------------------------
# Google Cloud Translation API key (https://console.cloud.google.com/apis/credentials).
# If empty, a mock pass-through translator is used so the chat still works.
TRANSLATE_API_KEY=

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (optional - only needed for `npm run db:push`)
# -----------------------------------------------------------------------------
# PostgreSQL / Neon connection string. Not required to run the app.
DATABASE_URL=postgresql://user:password@localhost:5432/agrimitra
