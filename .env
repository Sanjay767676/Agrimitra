# =============================================================================
# Agrimitra - Local environment variables (NOT committed to Git)
# Fill in your real keys below. See `.env.example` for descriptions.
# =============================================================================

# AI provider: `gemini` or `openai`
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Weather
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Translation (optional - mock translator is used when empty)
TRANSLATE_API_KEY=

# Server
PORT=5000
NODE_ENV=development

# Database (optional - only needed for `npm run db:push`)
DATABASE_URL=postgresql://user:password@localhost:5432/agrimitra
