# =============================================================================
# Agrimitra Backend - Environment Variables
# Copy this file to `.env` and fill in your own keys.
#   Windows:     Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit `.env` to Git.
# =============================================================================

# AI provider: `gemini` or `openai`. If empty, auto-detects from the keys below.
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/app/apikey) - powers the chatbot
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/api-keys) - only used when AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (https://openrouter.ai/keys) - powers up-to-date scheme generation
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Weather (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Translation (optional) - mock translator is used when empty
TRANSLATE_API_KEY=

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
# Use the SERVICE ROLE key here (server-side only, never expose in the browser).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server
PORT=5000
NODE_ENV=development
